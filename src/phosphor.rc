// App icon (tray, taskbar, Explorer).
1 ICON "../assets/phosphor.ico"

// Version info (Explorer > Properties > Details).
1 VERSIONINFO
FILEVERSION 0, 1, 0, 0
PRODUCTVERSION 0, 1, 0, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Phosphor CRT emulation"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "phosphor"
            VALUE "OriginalFilename", "phosphor.exe"
            VALUE "ProductName", "Phosphor"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "edenfps, GPL-3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
